{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dustpan >/dev/null 2>&1 && dustpan hook SessionStart || true",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dustpan >/dev/null 2>&1 && dustpan hook PostToolUse || true",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dustpan >/dev/null 2>&1 && dustpan hook SessionEnd || true",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
